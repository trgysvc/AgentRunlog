{
  "name": "agentrunlog",
  "version": "0.1.1",
  "description": "Typed engineering memory and Karpathy LLM Wiki for coding agents (Claude Code, Antigravity, Cursor, Codex)",
  "type": "module",
  "bin": {
    "agentrunlog": "./dist/cli/index.js",
    "runlog": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema.md",
    "README.md",
    "LICENSE",
    "plugin.json",
    "mcp_config.json",
    "hooks.json",
    "rules",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "hooks"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trgysvc/AgentRunlog.git"
  },
  "keywords": [
    "ai-agent",
    "memory",
    "llm-wiki",
    "claude-code",
    "antigravity",
    "cursor",
    "codex",
    "mcp",
    "developer-tools"
  ],
  "author": "Turgay Savacı",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
