{
  "description": "AgentRunlog typed engineering memory hooks for Claude Code",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.mjs\" claude session-start" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.mjs\" claude prompt-submit" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.mjs\" claude post-tool-use" } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.mjs\" claude pre-compact" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bundle/hook.mjs\" claude session-end" } ] }
    ]
  }
}
